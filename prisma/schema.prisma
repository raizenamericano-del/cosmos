// ============================================================
// COSMOS ACADEMY — Prisma Schema
// Provider : PostgreSQL (Supabase / Neon / local Postgres)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------- AUTH (NextAuth) ----------------------
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String? // dipetakan dari kolom `avatar` pada spesifikasi
  passwordHash  String?
  role          String    @default("cadet") // cadet | captain | admin
  emailVerified DateTime?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts     Account[]
  sessions     Session[]
  quizResults  QuizResult[]
  bookmarks    Bookmark[]
  achievements Achievement[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------- KONTEN EDUKASI ----------------------
model Article {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  category  String // Planet | Bintang | Black Hole | Galaksi | Nebula | Asteroid & Komet | Eksoplanet | Teori Alam Semesta
  type      String   @default("fact") // fact | fiction
  summary   String
  content   String   @db.Text
  funFacts  String[] @map("fun_facts")
  imageUrl  String?  @map("image_url")
  readTime  Int      @default(5) @map("read_time")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  bookmarks Bookmark[]

  @@index([category])
  @@index([type])
  @@map("articles")
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  articleId String   @map("article_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([userId])
  @@map("bookmarks")
}

// ---------------------- FIKSI ILMIAH ----------------------
model AlienSpecies {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  homePlanet     String   @map("home_planet")
  homePlanetSlug String?  @map("home_planet_slug")
  kardashevLevel String   @map("kardashev_level") // I | II | III
  status         String // damai | berbahaya | misterius | netral
  abilities      String[]
  lore           String   @db.Text
  appearance     String
  avatarUrl      String?  @map("avatar_url")
  accentColor    String   @default("#8b5cf6") @map("accent_color")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([status])
  @@map("alien_species")
}

model FictionalPlanet {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  tagline      String
  description  String   @db.Text
  atmosphere   String
  inhabitants  String
  resources    String[]
  dangerLevel  Int      @map("danger_level") // 1 - 10
  beautyScore  Int      @map("beauty_score") // 1 - 10
  themeColor   String   @map("theme_color")
  gradientFrom String   @map("gradient_from")
  gradientTo   String   @map("gradient_to")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("fictional_planets")
}

// ---------------------- KUIS ----------------------
model QuizQuestion {
  id            String   @id @default(cuid())
  category      String
  question      String
  options       String[]
  correctAnswer Int      @map("correct_answer") // index jawaban benar (0-based)
  explanation   String
  difficulty    String   @default("mudah")
  order         Int      @default(0)

  @@index([category])
  @@map("quiz_questions")
}

model QuizResult {
  id       String   @id @default(cuid())
  userId   String   @map("user_id")
  category String
  score    Int
  total    Int
  playedAt DateTime @default(now()) @map("played_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([score])
  @@map("quiz_results")
}

// ---------------------- GAMIFIKASI ----------------------
model Achievement {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  badgeName  String   @map("badge_name")
  description String?
  unlockedAt DateTime @default(now()) @map("unlocked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeName])
  @@index([userId])
  @@map("achievements")
}

// ---------------------- SINYAL MISTERIUS ----------------------
model Signal {
  id             String   @id @default(cuid())
  title          String
  difficulty     Int      // 1 | 2 | 3 | 4
  encodedMessage String   @db.Text @map("encoded_message")
  decodedMessage String   @db.Text @map("decoded_message")
  hint           String
  cipher         String // binary | caesar | rot13 | symbol
  sender         String
  rewardBadge    String   @map("reward_badge")
  order          Int      @default(0)

  @@map("signals")
}
