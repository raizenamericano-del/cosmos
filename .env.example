# ============================================================
# COSMOS ACADEMY — CONTOH VARIABEL LINGKUNGAN
# Salin file ini menjadi `.env` lalu isi nilainya.
# JANGAN pernah commit file `.env` yang berisi key asli.
# ============================================================

# ---------- DATABASE (PostgreSQL / Supabase) ----------
# Supabase → Project Settings → Database → Connection string → URI
# Contoh: postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cosmos_academy?schema=public"
# Koneksi langsung (dipakai `prisma migrate dev` / `db push`). Opsional di Supabase.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/cosmos_academy?schema=public"

# ---------- NEXTAUTH / AUTH.JS ----------
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="ganti-dengan-string-acak-panjang-minimal-32-karakter"
# URL publik aplikasi (lokal: http://localhost:3000, produksi: https://domain-anda.vercel.app)
NEXTAUTH_URL="http://localhost:3000"

# ---------- OAUTH (opsional — login email/password tetap bisa tanpa ini) ----------
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# GitHub: https://github.com/settings/developers
# Callback: https://domain-anda/api/auth/callback/github
GITHUB_ID=""
GITHUB_SECRET=""

# ---------- VERCEL / FUTURE FLAGS ----------
# Set "1" untuk mengaktifkan mode baca-tulis database.
# Jika dikosongkan, aplikasi otomatis berjalan dalam MODE DEMO
# (memakai data statis di src/lib/data/* tanpa database).
NEXT_PUBLIC_ENABLE_DEMO_SEED="1"

# ---------- OPSIONAL: ANALYTICS / MONITORING ----------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
